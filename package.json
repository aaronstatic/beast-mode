{
  "name": "beast-mode",
  "version": "6.2.4",
  "description": "Beast Mode workflow system for agent harnesses.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "beast-mode": "./installer/bin/beast-mode.js" },
  "scripts": { "test": "node --test installer/test/*.test.js dsh/test/*.test.js && bash scripts/orca-gate.sh" },
  "exports": {
    "./client": "./dsh/panel/client.js",
    "./cordis.patch.yml": "./dsh/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./dsh/cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "files": [
    "installer/",
    "templates/",
    "dsh/",
    "!dsh/src/",
    "!dsh/test/",
    ".claude-plugin/plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": { "esbuild": "^0.28.2" }
}
